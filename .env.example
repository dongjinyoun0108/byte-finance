# --- Instagram (Business or Creator account linked to a Facebook Page) ---
IG_USER_ID=
# System User token from Meta Business Manager (never expires)
IG_ACCESS_TOKEN=
IG_GRAPH_VERSION=v23.0

# --- Canva Connect (developer integration) ---
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_MORNING_TEMPLATE_ID=EAHXNvzp9TE

# --- Claude (writes the three stories) ---
ANTHROPIC_API_KEY=
# Cheapest model. Switch to claude-sonnet-5-5 for sharper writing.
CLAUDE_MODEL=claude-haiku-4-5-20251001

# --- Supabase (dedupe log, Canva token, image hosting) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=cards

# --- Ops ---
# Long random string; also goes into sql/002_schedule.sql
CRON_SECRET=
# Optional Slack/Discord webhook for failed or posted-with-gaps runs
ALERT_WEBHOOK_URL=
# Kill switch: true stops all posting instantly
PAUSED=false

# --- Optional board tweaks ---
# ASX_SYMBOL=^AXJO
# ASX_LABEL=ASX 200 (close)
